<head>
    <style>
      .body {
        font-family: "Roboto", sans-serif;
        font-size: 16px;
        color: black;
        margin: 1rem;
      }

      .title {
        margin: 16px 0;
      }

      .wrapper {
        background-color: white;
        width: 640px;
        border-radius: 1rem;
        border: 1px solid #864788;
        overflow: hidden;
      }

      .header {
        display: inline-block;
        width: 100%;
        text-align: center;
        background-color: #9e6ca0;
        padding: 1.5rem 0;
        color: #500050;
      }

      .content {
        font-size: 14px;
        padding: 1.5rem;
        text-align: center;
      }

      .content button {
        padding: 8px 16px;
        width: 200px;
        background-color: #9e6ca0;
        border: 1px solid #864788;
        border-radius: 0.5rem;
        cursor: pointer;
        color: #500050;
      }

      .divider {
        height: 1px;
        width: 100%;
        background-color: #864788;
      }

      .footer {
        text-align: left;
        padding: 1.5rem;
        font-size: 14px;
      }
    </style>
</head>